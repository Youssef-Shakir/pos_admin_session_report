<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- English Template -->
    <t t-name="pos_admin_session_report.CustomSessionReport" owl="1">
        <div class="pos-custom-report" style="font-family: Arial, sans-serif; font-size: 12px; width: 300px; max-width: 100%; margin: 0 auto; padding: 12px 16px; box-sizing: border-box;">
            <style>
                @media print {
                    @page { margin: 12mm 10mm 12mm 16mm; }
                    .pos-custom-report { margin-left: auto !important; margin-right: auto !important; }
                }
            </style>
            <div style="text-align: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 10px;">
                <strong style="font-size: 16px; font-weight: bold;">SESSION REPORT</strong><br/>
                <strong t-esc="data.config_name"/><br/>
                <span t-esc="data.session_name"/>
            </div>

            <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px;">
                <tr>
                    <td style="font-weight: bold;">Opened:</td>
                    <td style="text-align: right;" t-esc="data.opening_date"/>
                </tr>
                <tr t-if="data.closing_date">
                    <td style="font-weight: bold;">Closed:</td>
                    <td style="text-align: right;" t-esc="data.closing_date"/>
                </tr>
                <tr>
                    <td style="font-weight: bold;">Closing Cashier:</td>
                    <td style="text-align: right;" t-esc="data.closing_cashier"/>
                </tr>
            </table>

            <!-- Sales by Category -->
            <div style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">SALES BY CATEGORY</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="text-align: left; padding: 4px; border: 1px solid #000; font-weight: bold;">Category</th>
                            <th style="text-align: center; padding: 4px; border: 1px solid #000; font-weight: bold;">Qty</th>
                            <th style="text-align: right; padding: 4px; border: 1px solid #000; font-weight: bold;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.categories" t-as="cat" t-key="cat.name">
                            <tr>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="cat.name"/>
                                <td style="text-align: center; padding: 3px; border: 1px solid #000;" t-esc="cat.qty"/>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(cat.total)"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Employees -->
            <div style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">SALES BY EMPLOYEE</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="text-align: left; padding: 4px; border: 1px solid #000; font-weight: bold;">Employee</th>
                            <th style="text-align: center; padding: 4px; border: 1px solid #000; font-weight: bold;">Orders</th>
                            <th style="text-align: right; padding: 4px; border: 1px solid #000; font-weight: bold;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.employees" t-as="emp" t-key="emp.name">
                            <tr>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="emp.name"/>
                                <td style="text-align: center; padding: 3px; border: 1px solid #000;" t-esc="emp.orders"/>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(emp.total)"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Totals -->
            <div style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">TOTALS</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <tbody>
                        <tr>
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;">Gross Total (Before Discount):</td>
                            <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(data.gross_total)"/>
                        </tr>
                        <tr>
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;">Total Discount:</td>
                            <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(data.total_discount)"/>
                        </tr>
                        <tr>
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;">Total Refunds:</td>
                            <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(data.total_refunds)"/>
                        </tr>
                        <tr style="background-color: #f0f0f0;">
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;">Net Total:</td>
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="formatCurrency(data.net_total)"/>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Discount Details -->
            <div t-if="data.discount_orders and data.discount_orders.length" style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">DISCOUNT DETAILS</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="text-align: left; padding: 4px; border: 1px solid #000; font-weight: bold;">Order</th>
                            <th style="text-align: left; padding: 4px; border: 1px solid #000; font-weight: bold;">Employee</th>
                            <th style="text-align: right; padding: 4px; border: 1px solid #000; font-weight: bold;">Discount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.discount_orders" t-as="disc" t-key="disc_index">
                            <tr>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;">#<t t-esc="disc.ref"/><t t-if="disc.table"> T<t t-esc="disc.table"/></t></td>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="disc.employee"/>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(disc.amount)"/>
                            </tr>
                            <tr>
                                <td colspan="3" style="text-align: left; padding: 3px; border: 1px solid #000; font-size: 10px;" t-esc="disc.items"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Session Info -->
            <div style="margin-bottom: 10px;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tbody>
                        <tr>
                            <td style="font-weight: bold;">Number of Transactions:</td>
                            <td style="text-align: right;" t-esc="data.num_transactions"/>
                        </tr>
                        <tr>
                            <td style="font-weight: bold;">Deleted Orders:</td>
                            <td style="text-align: right;" t-esc="data.deleted_orders"/>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Cancelled Orders -->
            <div t-if="data.cancelled_orders and data.cancelled_orders.length" style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">CANCELLED ORDERS</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="text-align: left; padding: 4px; border: 1px solid #000; font-weight: bold;">Order</th>
                            <th style="text-align: left; padding: 4px; border: 1px solid #000; font-weight: bold;">By</th>
                            <th style="text-align: right; padding: 4px; border: 1px solid #000; font-weight: bold;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.cancelled_orders" t-as="canc" t-key="canc.id">
                            <tr>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;">#<t t-esc="canc.ref"/><t t-if="canc.table"> T<t t-esc="canc.table"/></t> <span style="font-weight: normal;" t-esc="canc.time"/></td>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="canc.by"/>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(canc.amount)"/>
                            </tr>
                            <tr t-if="canc.items">
                                <td colspan="3" style="text-align: left; padding: 3px; border: 1px solid #000; font-size: 10px;" t-esc="canc.items"/>
                            </tr>
                            <tr>
                                <td colspan="3" style="text-align: left; padding: 3px; border: 1px solid #000;"><strong>Reason:</strong> <t t-if="canc.reason" t-esc="canc.reason"/><t t-else="">No reason entered</t></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Payments -->
            <div style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">PAYMENTS</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <tbody>
                        <t t-foreach="data.payments" t-as="payment" t-key="payment.method">
                            <tr>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="payment.method"/>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(payment.total)"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Cash in / out (session expenses) -->
            <div t-if="data.cash_moves and data.cash_moves.length" style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">CASH IN / OUT (EXPENSES)</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <tbody>
                        <t t-foreach="data.cash_moves" t-as="move" t-key="move.id">
                            <tr>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;">
                                    <strong t-if="move.type == 'out'">OUT</strong><strong t-else="">IN</strong>
                                    <span t-esc="move.time"/> · <span t-esc="move.reason"/>
                                    <t t-if="move.category"><br/><span style="font-size: 10px;" t-esc="move.category"/></t>
                                    <t t-if="move.by"><span style="font-size: 10px;"> · <t t-esc="move.by"/></span></t>
                                </td>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000; white-space: nowrap;" t-esc="formatCurrency(move.amount)"/>
                            </tr>
                        </t>
                        <tr style="background-color: #f0f0f0;">
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;">Total Cash Out:</td>
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="formatCurrency(data.cash_out_total)"/>
                        </tr>
                        <tr t-if="data.cash_in_total">
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;">Total Cash In:</td>
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="formatCurrency(data.cash_in_total)"/>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Closing -->
            <div t-if="data.closing" style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">CLOSING</strong>
                <t t-set="cash" t-value="data.closing.cash"/>
                <table t-if="cash" style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <tbody>
                        <tr><td style="text-align: left; padding: 3px; border: 1px solid #000;">Opening Cash:</td><td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(cash.opening)"/></tr>
                        <tr><td style="text-align: left; padding: 3px; border: 1px solid #000;">Cash Payments:</td><td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(cash.payments)"/></tr>
                        <tr><td style="text-align: left; padding: 3px; border: 1px solid #000;">Cash In / Out:</td><td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(cash.moves)"/></tr>
                        <tr style="background-color: #f0f0f0;"><td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;">Expected Cash:</td><td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="formatCurrency(cash.expected)"/></tr>
                        <tr t-if="cash.counted !== null"><td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;">Counted Cash:</td><td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="formatCurrency(cash.counted)"/></tr>
                        <tr t-if="cash.difference !== null">
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold; font-size: 14px;">
                                <t t-if="cash.difference &lt; 0">SHORTAGE:</t>
                                <t t-elif="cash.difference &gt; 0">OVERAGE:</t>
                                <t t-else="">DIFFERENCE:</t>
                            </td>
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold; font-size: 14px;" t-esc="formatCurrency(cash.difference)"/>
                        </tr>
                    </tbody>
                </table>
                <table t-if="data.closing.methods.filter((m) => !m.is_cash).length" style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="text-align: left; padding: 4px; border: 1px solid #000;">Method</th>
                            <th style="text-align: right; padding: 4px; border: 1px solid #000;">Expected</th>
                            <th style="text-align: right; padding: 4px; border: 1px solid #000;">Diff.</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.closing.methods.filter((m) => !m.is_cash)" t-as="m" t-key="m.method">
                            <tr>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="m.method"/>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(m.expected)"/>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;"><t t-if="m.difference !== null" t-esc="formatCurrency(m.difference)"/><t t-else="">-</t></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <div t-if="!data.closing.is_closing" style="font-size: 10px; margin-top: 3px;">Session still open: counted cash and difference are printed at closing.</div>
                <div t-if="data.closing.notes" style="margin-top: 5px;"><strong>Notes:</strong> <span t-esc="data.closing.notes"/></div>
            </div>

            <!-- Footer -->
            <div style="text-align: center; margin-top: 15px; padding-top: 10px; border-top: 2px solid #000; font-size: 10px;">
                <span t-esc="currentDateTime"/><br/>
                <strong t-esc="data.company_name"/><br/>
                <span t-esc="data.author"/>
            </div>
        </div>
    </t>

    <!-- Arabic Template -->
    <t t-name="pos_admin_session_report.CustomSessionReportArabic" owl="1">
        <div class="pos-custom-report" dir="rtl" style="font-family: Arial, Tahoma, sans-serif; font-size: 12px; width: 300px; max-width: 100%; margin: 0 auto; padding: 12px 16px; box-sizing: border-box; text-align: right;">
            <style>
                @media print {
                    @page { margin: 12mm 16mm 12mm 10mm; }
                    .pos-custom-report { margin-left: auto !important; margin-right: auto !important; }
                }
            </style>
            <div style="text-align: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 10px;">
                <strong style="font-size: 16px; font-weight: bold;">تقرير الجلسة</strong><br/>
                <strong t-esc="data.config_name"/><br/>
                <span t-esc="data.session_name"/>
            </div>

            <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px;">
                <tr>
                    <td style="font-weight: bold;">وقت الفتح:</td>
                    <td style="text-align: left;" t-esc="data.opening_date"/>
                </tr>
                <tr t-if="data.closing_date">
                    <td style="font-weight: bold;">وقت الاغلاق:</td>
                    <td style="text-align: left;" t-esc="data.closing_date"/>
                </tr>
                <tr>
                    <td style="font-weight: bold;">امين الصندوق المغلق:</td>
                    <td style="text-align: left;" t-esc="data.closing_cashier"/>
                </tr>
            </table>

            <!-- Sales by Category -->
            <div style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">المبيعات حسب الفئة</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="text-align: right; padding: 4px; border: 1px solid #000; font-weight: bold;">الفئة</th>
                            <th style="text-align: center; padding: 4px; border: 1px solid #000; font-weight: bold;">الكمية</th>
                            <th style="text-align: left; padding: 4px; border: 1px solid #000; font-weight: bold;">المجموع</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.categories" t-as="cat" t-key="cat.name">
                            <tr>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="cat.name"/>
                                <td style="text-align: center; padding: 3px; border: 1px solid #000;" t-esc="cat.qty"/>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(cat.total)"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Employees -->
            <div style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">المبيعات حسب الموظف</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="text-align: right; padding: 4px; border: 1px solid #000; font-weight: bold;">الموظف</th>
                            <th style="text-align: center; padding: 4px; border: 1px solid #000; font-weight: bold;">الطلبات</th>
                            <th style="text-align: left; padding: 4px; border: 1px solid #000; font-weight: bold;">المجموع</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.employees" t-as="emp" t-key="emp.name">
                            <tr>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="emp.name"/>
                                <td style="text-align: center; padding: 3px; border: 1px solid #000;" t-esc="emp.orders"/>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(emp.total)"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Totals -->
            <div style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">الاجماليات</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <tbody>
                        <tr>
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;">الاجمالي قبل الخصم:</td>
                            <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(data.gross_total)"/>
                        </tr>
                        <tr>
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;">اجمالي الخصم:</td>
                            <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(data.total_discount)"/>
                        </tr>
                        <tr>
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;">اجمالي المرتجعات:</td>
                            <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(data.total_refunds)"/>
                        </tr>
                        <tr style="background-color: #f0f0f0;">
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;">الصافي:</td>
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="formatCurrency(data.net_total)"/>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Discount Details -->
            <div t-if="data.discount_orders and data.discount_orders.length" style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">تفاصيل الخصومات</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="text-align: right; padding: 4px; border: 1px solid #000; font-weight: bold;">الطلب</th>
                            <th style="text-align: right; padding: 4px; border: 1px solid #000; font-weight: bold;">الموظف</th>
                            <th style="text-align: left; padding: 4px; border: 1px solid #000; font-weight: bold;">الخصم</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.discount_orders" t-as="disc" t-key="disc_index">
                            <tr>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;">#<t t-esc="disc.ref"/><t t-if="disc.table"> طاولة <t t-esc="disc.table"/></t></td>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="disc.employee"/>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(disc.amount)"/>
                            </tr>
                            <tr>
                                <td colspan="3" style="text-align: right; padding: 3px; border: 1px solid #000; font-size: 10px;" t-esc="disc.items"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Session Info -->
            <div style="margin-bottom: 10px;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tbody>
                        <tr>
                            <td style="font-weight: bold;">عدد المعاملات:</td>
                            <td style="text-align: left;" t-esc="data.num_transactions"/>
                        </tr>
                        <tr>
                            <td style="font-weight: bold;">الطلبات المحذوفة:</td>
                            <td style="text-align: left;" t-esc="data.deleted_orders"/>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Cancelled Orders -->
            <div t-if="data.cancelled_orders and data.cancelled_orders.length" style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">الطلبات الملغاة</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="text-align: right; padding: 4px; border: 1px solid #000; font-weight: bold;">الطلب</th>
                            <th style="text-align: right; padding: 4px; border: 1px solid #000; font-weight: bold;">بواسطة</th>
                            <th style="text-align: left; padding: 4px; border: 1px solid #000; font-weight: bold;">المبلغ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.cancelled_orders" t-as="canc" t-key="canc.id">
                            <tr>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;">#<t t-esc="canc.ref"/><t t-if="canc.table"> طاولة <t t-esc="canc.table"/></t> <span style="font-weight: normal;" t-esc="canc.time"/></td>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="canc.by"/>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(canc.amount)"/>
                            </tr>
                            <tr t-if="canc.items">
                                <td colspan="3" style="text-align: right; padding: 3px; border: 1px solid #000; font-size: 10px;" t-esc="canc.items"/>
                            </tr>
                            <tr>
                                <td colspan="3" style="text-align: right; padding: 3px; border: 1px solid #000;"><strong>السبب:</strong> <t t-if="canc.reason" t-esc="canc.reason"/><t t-else="">لم يتم إدخال سبب</t></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Payments -->
            <div style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">المدفوعات</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <tbody>
                        <t t-foreach="data.payments" t-as="payment" t-key="payment.method">
                            <tr>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="payment.method"/>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(payment.total)"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Cash in / out -->
            <div t-if="data.cash_moves and data.cash_moves.length" style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">الإيداع والسحب النقدي (المصاريف)</strong>
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <tbody>
                        <t t-foreach="data.cash_moves" t-as="move" t-key="move.id">
                            <tr>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;">
                                    <strong t-if="move.type == 'out'">سحب</strong><strong t-else="">إيداع</strong>
                                    <span t-esc="move.time"/> · <span t-esc="move.reason"/>
                                    <t t-if="move.category"><br/><span style="font-size: 10px;" t-esc="move.category"/></t>
                                    <t t-if="move.by"><span style="font-size: 10px;"> · <t t-esc="move.by"/></span></t>
                                </td>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000; white-space: nowrap;" t-esc="formatCurrency(move.amount)"/>
                            </tr>
                        </t>
                        <tr style="background-color: #f0f0f0;">
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;">إجمالي السحب:</td>
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="formatCurrency(data.cash_out_total)"/>
                        </tr>
                        <tr t-if="data.cash_in_total">
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;">إجمالي الإيداع:</td>
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="formatCurrency(data.cash_in_total)"/>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Closing -->
            <div t-if="data.closing" style="margin-bottom: 10px;">
                <strong style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #000; display: block; padding-bottom: 3px;">إغلاق الصندوق</strong>
                <t t-set="cash" t-value="data.closing.cash"/>
                <table t-if="cash" style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <tbody>
                        <tr><td style="text-align: right; padding: 3px; border: 1px solid #000;">نقد الافتتاح:</td><td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(cash.opening)"/></tr>
                        <tr><td style="text-align: right; padding: 3px; border: 1px solid #000;">المبيعات النقدية:</td><td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(cash.payments)"/></tr>
                        <tr><td style="text-align: right; padding: 3px; border: 1px solid #000;">الإيداع / السحب:</td><td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(cash.moves)"/></tr>
                        <tr style="background-color: #f0f0f0;"><td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;">النقد المتوقع:</td><td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="formatCurrency(cash.expected)"/></tr>
                        <tr t-if="cash.counted !== null"><td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold;">النقد المعدود:</td><td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;" t-esc="formatCurrency(cash.counted)"/></tr>
                        <tr t-if="cash.difference !== null">
                            <td style="text-align: right; padding: 3px; border: 1px solid #000; font-weight: bold; font-size: 14px;">
                                <t t-if="cash.difference &lt; 0">عجز:</t>
                                <t t-elif="cash.difference &gt; 0">زيادة:</t>
                                <t t-else="">الفرق:</t>
                            </td>
                            <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold; font-size: 14px;" t-esc="formatCurrency(cash.difference)"/>
                        </tr>
                    </tbody>
                </table>
                <table t-if="data.closing.methods.filter((m) => !m.is_cash).length" style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid #000;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="text-align: right; padding: 4px; border: 1px solid #000;">الطريقة</th>
                            <th style="text-align: left; padding: 4px; border: 1px solid #000;">المتوقع</th>
                            <th style="text-align: left; padding: 4px; border: 1px solid #000;">الفرق</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.closing.methods.filter((m) => !m.is_cash)" t-as="m" t-key="m.method">
                            <tr>
                                <td style="text-align: right; padding: 3px; border: 1px solid #000;" t-esc="m.method"/>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000;" t-esc="formatCurrency(m.expected)"/>
                                <td style="text-align: left; padding: 3px; border: 1px solid #000; font-weight: bold;"><t t-if="m.difference !== null" t-esc="formatCurrency(m.difference)"/><t t-else="">-</t></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <div t-if="!data.closing.is_closing" style="font-size: 10px; margin-top: 3px;">الجلسة مفتوحة: النقد المعدود والفرق يطبعان عند الإغلاق.</div>
                <div t-if="data.closing.notes" style="margin-top: 5px;"><strong>ملاحظات:</strong> <span t-esc="data.closing.notes"/></div>
            </div>

            <!-- Footer -->
            <div style="text-align: center; margin-top: 15px; padding-top: 10px; border-top: 2px solid #000; font-size: 10px;">
                <span t-esc="currentDateTime"/><br/>
                <strong t-esc="data.company_name"/><br/>
                <span t-esc="data.author"/>
            </div>
        </div>
    </t>

</templates>
